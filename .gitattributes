# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text eol=lf

# Documentation files
*.md text eol=lf
*.txt text eol=lf

# Excel files (binary)
*.xlsx binary
*.xls binary

# CSV files
*.csv text eol=lf

# Configuration files
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf

# Script files
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf

# Image files (binary)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# Archive files (binary)
*.zip binary
*.tar binary
*.gz binary
